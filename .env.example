# ==============================================================================
# CivicFlow Configuration Template
# Copy this file to .env and configure values.
# NEVER commit your real .env file into Git / version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Mode ('development', 'staging', 'production')
# In 'production', debug and test endpoints are automatically disabled.
# ------------------------------------------------------------------------------
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Security & Authentication
# Generate a secure 32+ character random string in production (e.g. openssl rand -hex 32)
# ------------------------------------------------------------------------------
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Database Configuration
# Production (Supabase Free PostgreSQL):
# Session Pooler (port 5432) or Transaction Pooler (port 6543):
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Direct Connection:
# DATABASE_URL=postgresql://postgres:yourpassword@db.yourprojectref.supabase.co:5432/postgres
# Local Development Fallback:
DATABASE_URL=sqlite:///./civicflow.db

# ------------------------------------------------------------------------------
# AI Engine (Official Google Gemini API)
# Get your Gemini API key from Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# Geocoding & Mapping Services (OpenStreetMap / Nominatim)
# Custom User-Agent header for Nominatim / OSM policy compliance:
# ------------------------------------------------------------------------------
GEOCODING_USER_AGENT=CivicFlow/1.0 (civicflow-prod@users.noreply.github.com)
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_TIMEOUT_SECONDS=10
LOCATION_MISMATCH_THRESHOLD_METERS=500

# ------------------------------------------------------------------------------
# Server & CORS Networking
# In production, set CORS_ORIGINS to your Vercel frontend URL:
# CORS_ORIGINS=https://civicflow.vercel.app,http://localhost:5173
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Media Uploads & Storage
# For local dev: STORAGE_BACKEND=local
# For production Free Tier: STORAGE_BACKEND=supabase
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=image/jpeg,image/png,image/webp

# ------------------------------------------------------------------------------
# Supabase Free Cloud Storage (Required for Production Free Tier)
# Get credentials from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
SUPABASE_STORAGE_BUCKET=complaints
